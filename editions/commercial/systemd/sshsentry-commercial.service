# Example unit for the experimental SSH Sentry Commercial Edition (not installed anywhere).
# Restart=always brings it back after kill -9 / crashes; WatchdogSec makes systemd restart it
# if the main loop stops sending WATCHDOG=1 (sent via $NOTIFY_SOCKET, no extra dependencies).
# On the restart after an unclean stop SSH Sentry Commercial Edition raises a MEDIUM "was not running" alert.
[Unit]
Description=SSH Sentry Commercial Edition intrusion detection (experimental, detection only)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 /opt/sshsentry-commercial/sshsentry_commercial.py -c /etc/sshsentry/sshsentry.yaml
Restart=always
RestartSec=5
WatchdogSec=60
# Optional secrets (webhook / heartbeat URLs, SMTP password):
EnvironmentFile=-/etc/sshsentry/env
# Read-only hardening: it only reads logs and writes its state DB.
ProtectSystem=strict
ReadWritePaths=/var/lib/sshsentry
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
